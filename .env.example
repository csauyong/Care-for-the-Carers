# Copy to .env and fill in. Every setting except TELEGRAM_BOT_TOKEN has a default.

# From @BotFather on Telegram (https://core.telegram.org/bots/tutorial#obtain-your-bot-token)
TELEGRAM_BOT_TOKEN=

# --- Model -----------------------------------------------------------------
# anthropic (default) | openai (any OpenAI-compatible server) | scripted (canned replies, for testing)
CAREBOT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 for anthropic. Required for openai.
# CAREBOT_MODEL=
# Reasoning effort for Claude replies: low | medium | high
# CAREBOT_EFFORT=low

# For CAREBOT_PROVIDER=openai:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama; omit for api.openai.com

# --- Behaviour -------------------------------------------------------------
# keyword (free, instant) | llm (Claude rates each message; better recall, costs a call per message)
# CAREBOT_DETECTOR=keyword
# CAREBOT_STRESS_THRESHOLD=3
# CAREBOT_HISTORY_TURNS=20
# Your own contacts file, e.g. for another city (copy src/carebot/data/hong_kong.yaml)
# CAREBOT_RESOURCES_FILE=

# --- Hosting ---------------------------------------------------------------
# Sessions (SQLite) and traces (JSONL) are written here.
# CAREBOT_DATA_DIR=data
# Set to false to keep message text out of traces.
# CAREBOT_TRACE_CONTENT=true
# Public https URL of this server to use webhooks instead of polling.
# CAREBOT_WEBHOOK_URL=https://carebot.example.org
# CAREBOT_PORT=8080

# --- Evals -----------------------------------------------------------------
# CAREBOT_JUDGE_MODEL=claude-opus-5-5
# CAREBOT_SIMULATOR_MODEL=claude-sonnet-5-5
